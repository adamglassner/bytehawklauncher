<Window x:Class="Bytehawk.Launcher.Views.SoftwareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add software" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,20,24,22">
    <StackPanel Orientation="Horizontal">
      <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
          <Image x:Name="IconImage" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="IconFallback" Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="20"
                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TextBlock x:Name="Heading" Text="Add software" Style="{StaticResource SectionTitle}" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock x:Name="ProgramLabel" Text="Program (.exe, .msi or shortcut)" Style="{StaticResource FieldLabel}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PathBox" LostFocus="PathBox_LostFocus" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
    </Grid>

    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="NameBox" />

    <TextBlock Text="Category (optional)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="CategoryBox" MaxLength="40" ToolTip="Type your own or pick one below" />
    <WrapPanel x:Name="CategoryChips" Margin="0,6,0,0" />

    <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" Height="56" VerticalContentAlignment="Top" MaxLength="300" />

    <TextBlock Text="Website (optional)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="WebsiteBox" ToolTip="The program's home page, e.g. example.com. Opens from the globe button on the card." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Version (optional)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="VersionBox" MaxLength="40" ToolTip="Filled in from the program's file version when available. You can change it." />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Launch arguments (optional)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ArgsBox" />
        <TextBlock x:Name="ArgsNote" Text="Not available for Store apps" Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Grid>

    <CheckBox x:Name="AdminBox" Content="Run as administrator" Margin="0,16,0,0" />

    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,14,0,0"
               Text="Removing an entry later only removes it from the launcher. Your files are never deleted." />

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
      <Button x:Name="OkButton" Content="Add" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
