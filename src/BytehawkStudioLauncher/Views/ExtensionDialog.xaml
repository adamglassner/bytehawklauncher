<Window x:Class="Bytehawk.Launcher.Views.ExtensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to browser" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,20,24,22">
    <TextBlock x:Name="Heading" Text="Add to your browser" Style="{StaticResource SectionTitle}" FontSize="18" />
    <TextBlock x:Name="Intro" Style="{StaticResource Subtle}" TextWrapping="Wrap"
               Text="Chrome and Edge only add extensions from their own stores by themselves, so this one is added once by hand. It takes about a minute." />

    <TextBlock Text="Extension folder" Style="{StaticResource FieldLabel}" />
    <DockPanel>
      <Button x:Name="CopyButton" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="90" Click="Copy_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="CopyText" Text="Copy" />
        </StackPanel>
      </Button>
      <TextBox x:Name="FolderBox" IsReadOnly="True" />
    </DockPanel>

    <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource AccentSoft}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Steps" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Run FontWeight="SemiBold" Text="1." /> Click <Run FontWeight="SemiBold" Text="Open Chrome" /> or <Run FontWeight="SemiBold" Text="Open Edge" /> below. Its Extensions page opens, and the folder above is copied for you.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Run FontWeight="SemiBold" Text="2." /> Turn on <Run FontWeight="SemiBold" Text="Developer mode" /> (top right in Chrome, on the left in Edge).
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Run FontWeight="SemiBold" Text="3." /> Click <Run FontWeight="SemiBold" Text="Load unpacked" />, press <Run FontWeight="SemiBold" Text="Ctrl+V" /> to paste the folder into the address bar of the folder window, press Enter, then click <Run FontWeight="SemiBold" Text="Select Folder" />.
        </TextBlock>
        <TextBlock x:Name="PinStep" TextWrapping="Wrap" Margin="0,2">
          <Run FontWeight="SemiBold" Text="4." /> Click the puzzle-piece icon in the browser toolbar and pin it.
        </TextBlock>
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="Already added? You're all set. The launcher installs updates into the same folder; the browser loads the new version the next time it starts, or right away if you click the reload arrow on the extension in its Extensions page." />

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

    <DockPanel Margin="0,18,0,0">
      <Button Content="Done" IsCancel="True" IsDefault="True" DockPanel.Dock="Right" MinWidth="90" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ChromeButton" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OpenChrome_Click">
          <TextBlock Text="Open Chrome" />
        </Button>
        <Button x:Name="EdgeButton" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OpenEdge_Click">
          <TextBlock Text="Open Edge" />
        </Button>
        <Button Margin="0,0,8,0" Click="ShowFolder_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Show folder" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
