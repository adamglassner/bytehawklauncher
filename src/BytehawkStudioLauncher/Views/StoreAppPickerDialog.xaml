<Window x:Class="Bytehawk.Launcher.Views.StoreAppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a Microsoft Store app" Width="520" Height="600" MinHeight="400" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <DockPanel Margin="24,20,24,22">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Add a Microsoft Store app" Style="{StaticResource SectionTitle}" FontSize="18" />
      <TextBlock Style="{StaticResource Subtle}"
                 Text="Apps installed from the Microsoft Store (and other packaged apps) on this PC. Pick one to add it to My Software." />
      <Grid Margin="0,14,0,0">
        <TextBox x:Name="SearchBox" Padding="34,8,8,8" TextChanged="Search_Changed" />
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
      </Grid>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
      <Button x:Name="OkButton" Content="Next" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" IsEnabled="False" Click="Ok_Click" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Subtle}" FontSize="12" Margin="0,10,0,0" Text="Loading installed apps…" />
    <Border Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource CardBg}">
      <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Padding="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="AppList_SelectionChanged" MouseDoubleClick="AppList_DoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,3">
              <Grid Width="32" Height="32">
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
