<Window x:Class="Bytehawk.Launcher.Views.WebAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add web app" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,20,24,22">
    <TextBlock x:Name="Heading" Text="Add web app" Style="{StaticResource SectionTitle}" FontSize="18" />
    <TextBlock Style="{StaticResource Subtle}" Text="A bookmark that opens in your default browser. Nothing is downloaded or installed." />

    <TextBlock Text="Web address" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="UrlBox" LostFocus="UrlBox_LostFocus" ToolTip="e.g. example.com or https://example.com/app" />

    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="NameBox" />

    <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" Height="56" VerticalContentAlignment="Top" MaxLength="300" />

    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,12,0,0"
               Text="The site's own icon is downloaded automatically and shown on the card." />

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
      <Button x:Name="OkButton" Content="Add" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
