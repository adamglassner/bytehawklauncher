<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BytehawkStudioLauncher</AssemblyName>
    <RootNamespace>Bytehawk.Launcher</RootNamespace>
    <ApplicationIcon>..\..\assets\bytehawk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version 1.0.0 everywhere -->
    <Version>1.3.9</Version>
    <AssemblyVersion>1.3.9.0</AssemblyVersion>
    <FileVersion>1.3.9.0</FileVersion>
    <InformationalVersion>1.3.9</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Bytehawk Studio Launcher</Product>
    <AssemblyTitle>Bytehawk Studio Launcher</AssemblyTitle>
    <Company>Bytehawk Studio</Company>
    <Authors>Bytehawk Studio</Authors>
    <Copyright>© Bytehawk Studio</Copyright>

    <!-- Windows 10/11 x64, self-contained single-file -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\bytehawk.ico" Link="Assets\bytehawk.ico" />
    <Resource Include="..\..\assets\logo-mark-ondark.png" Link="Assets\logo-mark-ondark.png" />
    <Resource Include="..\..\assets\logo-mark-onlight.png" Link="Assets\logo-mark-onlight.png" />
  </ItemGroup>

</Project>
