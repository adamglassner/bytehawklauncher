<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme. Accent and layout are shared; only surfaces and text change. -->
  <SolidColorBrush x:Key="WindowBg" Color="#F5F7FA" />
  <SolidColorBrush x:Key="SidebarBg" Color="#EBEFF5" />
  <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HoverBg" Color="#E6ECF3" />
  <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Stroke" Color="#D5DCE6" />
  <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5B6577" />
  <SolidColorBrush x:Key="Accent" Color="#0891B2" />
  <SolidColorBrush x:Key="AccentHover" Color="#0E7490" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSoft" Color="#1F0891B2" />
  <SolidColorBrush x:Key="WarningText" Color="#B45309" />
  <SolidColorBrush x:Key="WarningSoft" Color="#1FB45309" />
  <SolidColorBrush x:Key="DangerText" Color="#DC2626" />
  <SolidColorBrush x:Key="SuccessText" Color="#047857" />
  <SolidColorBrush x:Key="TrackBg" Color="#E2E8F0" />
  <BitmapImage x:Key="LogoMark" UriSource="pack://application:,,,/Assets/logo-mark-onlight.png" />
</ResourceDictionary>
